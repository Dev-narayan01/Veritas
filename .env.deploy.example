# Copy to .env.deploy (gitignored) and fill in. Never commit real values.
#
# Hugging Face
HF_USERNAME=your-username
SPACE_NAME=veritas-api
HF_TOKEN=
VERITAS_HUB_REPO=your-username/veritas-detector
#
# Vercel (the site the browser talks to; it must be the Space URL so the API is full mode)
VITE_API_BASE_URL=https://your-username-veritas-api.hf.space
#
# Optional: Supabase (not used by the running app today; reserved for reading the
# published metrics snapshot if a future phase needs it)
SUPABASE_URL=
SUPABASE_ANON_KEY=
