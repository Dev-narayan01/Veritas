# Virtualenvs / caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Secrets and local deployment files
.env
.env.deploy
.vercel/

# Data and model artifacts (regenerable; never committed)
data/veritas.sqlite3
data/raw/
data/processed/
data/corpus/
data/uploads/
data/eval/
data/index/
data/analyses/
ml/artifacts/*
ml/artifacts.previous/
!ml/artifacts/.gitkeep
# Trained artifacts are regenerated by ml/run_all.py and shipped as veritas_artifacts.zip
dist/
*.zip
ml/incoming/
dist/
*.zip

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/public/artifacts/
# Evaluation figures are the evidence behind /evaluation, so they are published with the
# site (428 KB). They previously 404'd because they were only ever written to the
# git-ignored training directory.
!frontend/public/metrics/plots/
# The pre-trained artifact bundle is served so a fresh clone can skip retraining.
!frontend/public/downloads/
frontend/.vite/
playwright-report/
test-results/

# OS
.DS_Store
